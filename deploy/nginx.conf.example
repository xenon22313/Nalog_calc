# /etc/nginx/conf.d/calcsite.conf
# Files in conf.d are included inside the http {} block, so limit_req_zone can live here.

# ~100 requests per minute per client IP for the calculator API.
limit_req_zone $binary_remote_addr zone=calc_api:10m rate=100r/m;

server {
    listen 80;
    server_name example.ru www.example.ru;
    # TODO: add HTTPS (certbot --nginx) and redirect http -> https.

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 500;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain;

    # Static files are served by nginx directly; URLs are versioned with ?v=<mtime>.
    location /static/ {
        alias /srv/calcsite/app/static/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location /api/calc/ {
        limit_req zone=calc_api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/calcsite_proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/calcsite_proxy.conf;
    }
}

# /etc/nginx/snippets/calcsite_proxy.conf
# X-Forwarded-For is overwritten with the real client address, so clients cannot spoof it.
# The app (TRUST_PROXY_HEADERS=1) and uvicorn (--proxy-headers) read the client IP from it.
#
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $remote_addr;
#   proxy_set_header X-Forwarded-Proto $scheme;
